statement ok
INSERT INTO fixture.aws_relationships VALUES
    ('r1','r2','peer',NULL),
    ('r1','r3','reads',NULL);

query TT
SELECT node_id, CAST(hop_count AS VARCHAR)
FROM graph_traverse('__sqllogictest_graph_traverse.duckdb', 'r1', 3, 'outbound', NULL)
ORDER BY hop_count, node_id;
----
r2 1
r3 1

query T
SELECT node_id
FROM graph_traverse('__sqllogictest_graph_traverse.duckdb', 'r1', 3, 'outbound', 'instance')
