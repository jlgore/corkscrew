statement ok
LOAD './build/corkscrew_graph.duckdb_extension';

statement ok
ATTACH '__sqllogictest_graph_traverse.duckdb' AS fixture;

statement ok
CREATE TABLE fixture.aws_resources (
    id VARCHAR, type VARCHAR, name VARCHAR, region VARCHAR,
    account_id VARCHAR, arn VARCHAR, tags VARCHAR
);

statement ok
CREATE TABLE fixture.aws_relationships (
    from_id VARCHAR, to_id VARCHAR,
    relationship_type VARCHAR, properties VARCHAR
);

statement ok
INSERT INTO fixture.aws_resources VALUES
